{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cnproduct/naike-export-kb-suite/schemas/knowledge-card.schema.json",
  "title": "Naike Export Knowledge Card",
  "type": "object",
  "required": [
    "kb_id",
    "module",
    "knowledge_kind",
    "entity_type",
    "entity_id",
    "title",
    "language",
    "status",
    "confidence",
    "sensitivity",
    "public_claim_approved",
    "source_refs",
    "conclusion",
    "conditions",
    "evidence",
    "red_lines",
    "pending_confirmations"
  ],
  "properties": {
    "kb_id": { "type": "string", "pattern": "^NK-[A-Z]{3,8}-[0-9]{4,6}$" },
    "module": { "type": "string", "pattern": "^(0[0-9]|1[0-9]|20)_[a-z0-9_]+$" },
    "knowledge_kind": { "enum": ["fact", "rule", "workflow", "template", "case_study", "training_material"] },
    "entity_type": { "enum": ["company", "brand", "product", "market", "buyer_persona", "policy", "sop", "glossary", "metric"] },
    "entity_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "default": "zh-CN" },
    "status": { "enum": ["verified_fact", "public_fact", "ai_inference", "strategy_recommendation", "pending_supplement", "deprecated"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sensitivity": { "enum": ["public", "internal", "restricted"] },
    "public_claim_approved": { "type": "boolean", "default": false },
    "source_refs": { "type": "array", "items": { "type": "string", "pattern": "^NK-EVD-[0-9]{4}$" } },
    "conclusion": { "type": "string" },
    "conditions": { "type": "string" },
    "evidence": { "type": "string" },
    "recommended_actions": { "type": "string" },
    "red_lines": { "type": "string" },
    "pending_confirmations": { "type": "string" },
    "verified_by": { "type": ["string", "null"] },
    "verified_at": { "type": ["string", "null"], "format": "date" },
    "valid_until": { "type": ["string", "null"], "format": "date" }
  },
  "additionalProperties": true
}
