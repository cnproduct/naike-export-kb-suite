{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cnproduct/naike-export-kb-suite/schemas/evidence-register.schema.json",
  "title": "Naike public-claim evidence register",
  "type": "object",
  "required": ["version", "last_reviewed_at", "policy", "claims"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "last_reviewed_at": { "type": "string", "format": "date" },
    "policy": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type", "captured_at", "evidence_level"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "file_name": { "type": "string" },
        "document_id": { "type": "string" },
        "captured_at": { "type": "string", "format": "date" },
        "evidence_level": { "enum": ["S", "A", "B", "C", "D", "I"] }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "topic",
        "claim",
        "status",
        "public_claim_approved",
        "source_refs",
        "required_evidence",
        "verified_by",
        "verified_at",
        "valid_until",
        "owner"
      ],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^NK-EVD-[0-9]{4}$" },
        "topic": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "claim": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "verified_fact",
            "public_fact",
            "ai_inference",
            "strategy_recommendation",
            "pending_supplement",
            "deprecated"
          ]
        },
        "public_claim_approved": { "type": "boolean" },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "verified_by": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"], "format": "date" },
        "valid_until": { "type": ["string", "null"], "format": "date" },
        "owner": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
